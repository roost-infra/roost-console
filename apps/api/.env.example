PORT=8080
APP_ENV=development
DATABASE_URL=postgres://roost_api.PROJECT_REF:PASSWORD@aws-0-ap-southeast-2.pooler.supabase.com:6543/postgres?sslmode=require
SUPABASE_URL=https://PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=
PUBLIC_BASE_URL=http://127.0.0.1:8080
CONSOLE_ORIGIN=http://127.0.0.1:5173
SERVICE_SECRET=change-me
XUNHUPAY_APPID=
XUNHUPAY_APPSECRET=
XUNHUPAY_API_BASE=https://api.xunhupay.com/payment/do.html
XUNHUPAY_NOTIFY_URL=http://127.0.0.1:8080/v1/payments/xunhupay/notify
XUNHUPAY_RETURN_URL=http://127.0.0.1:5173/billing

# Optional crypto checkout through a self-hosted EPUSDT (GM Pay) gateway.
# Leave EPUSDT_API_BASE empty to keep it off. EPUSDT_NOTIFY_URL must be a
# public URL: the gateway refuses localhost and private addresses.
EPUSDT_API_BASE=
EPUSDT_PID=
EPUSDT_SECRET_KEY=
EPUSDT_NOTIFY_URL=
EPUSDT_RETURN_URL=
# Comma-separated emails allowed to pay with crypto. Empty = every user.
EPUSDT_ALLOW_EMAILS=

# Referral program. Defaults are 1000/1000 credits; max uses 0 = unlimited.
REFERRAL_INVITER_CREDITS=1000
REFERRAL_INVITEE_CREDITS=1000
REFERRAL_MAX_USES_PER_CODE=0
RATE_REFERRAL_CLAIM_PER_MIN=10

# OIDC issuer for first-party products
OIDC_ISSUER=http://127.0.0.1:8080
OIDC_CLIENT_ID=roostbot
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URIS=http://127.0.0.1:8300/api/auth/oidc/callback
OIDC_CONSENT_URL=http://127.0.0.1:5175/oauth/authorize

